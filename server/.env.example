# Расположение: скопируйте этот файл в server/.env (cp .env.example .env).
# .env загружается config/env.js от пути модуля — cwd не важен (фикс после R.2).
# Корневой .env (до R.2) тоже подхватывается как legacy-fallback,
# но приоритет — у server/.env.

# Default provider (ollama | llama_cpp)
DEFAULT_PROVIDER=ollama

# Ollama configuration
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434

# llama.cpp configuration
LLAMA_CPP_ENABLED=true
LLAMA_CPP_URL=http://localhost:8080

# Server
PORT=3000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Colored output: true | false
LOG_COLORS=true
# Base directory for user files attached by relative path (PROJECT mode, future).
# Attachments with path_base='context' are resolved against it; paths escaping
# the directory are rejected (400). Not required for the current research workflow.
# CONTEXT_BASE_DIR=/home/selub/Documents/progs

# Max size of a reference file (PROJECT mode), bytes. Default: 1048576 (1 MB).
# Files larger than this are rejected at attach time ("errors" in the response);
# if a file grows beyond the limit after attach, it is excluded from [Материалы]
# (TOO LARGE block) and badged in the project panel.
# MAX_REFERENCE_FILE_SIZE=1048576
