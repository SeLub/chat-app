# Расположение: скопируйте этот файл в server/.env (cp .env.example .env).
# .env загружается config/env.js от пути модуля — cwd не важен (фикс после R.2).
# Корневой .env (до R.2) тоже подхватывается как legacy-fallback,
# но приоритет — у server/.env.

# Default provider (ollama | llama_cpp)
DEFAULT_PROVIDER=ollama

# Ollama configuration
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434

# llama.cpp configuration
LLAMA_CPP_ENABLED=true
LLAMA_CPP_URL=http://localhost:8080

# Server
PORT=3000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Colored output: true | false
LOG_COLORS=true